# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres. Matches docker-compose.yml out of the box.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epicor_pilot

# --- Shopify -----------------------------------------------------------------
# Store domain WITHOUT https:// — e.g. priceright-auto-parts.myshopify.com
SHOPIFY_STORE=priceright-auto-parts.myshopify.com
# Admin API access token from the custom app. Starts with shpat_
SHOPIFY_TOKEN=
# Pin the version. Do not use "latest".
SHOPIFY_API_VERSION=2026-07
# Products are pushed as DRAFT and tagged so the pilot is reversible.
SHOPIFY_PRODUCT_STATUS=DRAFT
SHOPIFY_PILOT_TAG=epicor-pilot

# --- Epicor ------------------------------------------------------------------
# EPICOR_MODE=fixtures  -> read saved JSON from ./fixtures (works today)
# EPICOR_MODE=live      -> call the pilot API (needs the values below)
EPICOR_MODE=fixtures
EPICOR_BASE_URL=https://portal.pilot.epicor-auto-catalog.cloud
EPICOR_AUTH_STYLE=bearer
EPICOR_TOKEN=
EPICOR_USERNAME=
EPICOR_PASSWORD=

# --- Pilot scope -------------------------------------------------------------
PILOT_CATEGORY=Ignition & Engine Filters
PILOT_GROUP=Engine Filters & PCV
PILOT_PART_TYPE=Oil Filter
PILOT_BRAND=
PILOT_PART_LIMIT=5

# --- Mapping options ---------------------------------------------------------
# Assumed when Epicor reports a weight with no unit. KILOGRAMS|GRAMS|POUNDS|OUNCES
EPICOR_WEIGHT_UNIT=POUNDS
# Create Shopify collections named after the Epicor category and group.
SHOPIFY_COLLECTIONS=true
